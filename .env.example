# PostgreSQL local development values only. Replace through environment-specific secret management.
POSTGRES_DB=ai_commerce
POSTGRES_USER=ai_commerce
POSTGRES_PASSWORD=ai_commerce_local

# Server-only URL used by the Next.js Route Handler. Never rename to NEXT_PUBLIC_*.
BACKEND_INTERNAL_URL=http://backend:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
